<script>
    (function() {
        var popup = document.getElementById('licencePopup');
        var popupImg = document.getElementById('licencePopupImg');
        var closeBtn = document.getElementById('licencePopupClose');
        var viewBtns = document.querySelectorAll('.licence-view-btn');

        function openPopup(src) {
            popupImg.src = src;
            popup.classList.add('active');
        }

        function closePopup() {
            popup.classList.remove('active');
            setTimeout(function() { popupImg.src = ''; }, 350);
        }

        viewBtns.forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                var img = btn.getAttribute('data-img');
                if (img) openPopup(img);
            });
        });

        closeBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            closePopup();
        });

        popup.addEventListener('click', function(e) {
            if (e.target === popup) closePopup();
        });

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && popup.classList.contains('active')) {
                closePopup();
            }
        });
    })();
</script>

<!-- ===== Vertical Nav Dots Script ===== -->
<script>
    (function() {
        var slider = document.getElementById('verticalSlider');
        var nav = document.querySelector('.vertical-nav');
        var dots = document.querySelectorAll('.nav-dot');
        var sections = document.querySelectorAll('.v-section');

        if (!slider || !nav || !dots.length || !sections.length) return;

        var hideTimer = null;
        var HIDE_DELAY = 1000; // 2 ثانية

        // إظهار النقط أثناء التمرير وإخفاؤها بعد 2 ثانية من آخر تمرير
        function showNavTemporarily() {
            // لا تظهر النقط لو إحنا في أول صفحة
            if (slider.scrollTop <= 50) {
                nav.classList.remove('visible');
                return;
            }

            nav.classList.add('visible');

            if (hideTimer) clearTimeout(hideTimer);
            hideTimer = setTimeout(function() {
                // متخفيش لو المستخدم لسه واقف في أول صفحة
                if (slider.scrollTop > 50) {
                    nav.classList.remove('visible');
                }
            }, HIDE_DELAY);
        }

        // تحديث النقطة النشطة حسب القسم الظاهر
        function updateActiveDot() {
            var scrollPos = slider.scrollTop + (window.innerHeight / 2);
            var currentIndex = 0;

            sections.forEach(function(section, index) {
                var sectionTop = section.offsetTop;
                var sectionBottom = sectionTop + section.offsetHeight;
                if (scrollPos >= sectionTop && scrollPos < sectionBottom) {
                    currentIndex = index;
                }
            });

            dots.forEach(function(dot, index) {
                if (index === currentIndex) {
                    dot.classList.add('active');
                } else {
                    dot.classList.remove('active');
                }
            });
        }

        // الضغط على النقطة ينقل للقسم المطلوب
        dots.forEach(function(dot) {
            dot.addEventListener('click', function() {
                var index = parseInt(dot.getAttribute('data-index'), 10);
                if (sections[index]) {
                    sections[index].scrollIntoView({ behavior: 'smooth' });
                    // إظهار النقط بعد النقل لبرهة
                    showNavTemporarily();
                }
            });
        });

        // ربط الأحداث
        slider.addEventListener('scroll', function() {
            showNavTemporarily();
            updateActiveDot();
        });

        // تشغيل أولي
        updateActiveDot();
        if (slider.scrollTop > 50) {
            showNavTemporarily();
        }
    })();
</script>
