<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
<title>EUROMECHANIC | FullPage Vertical Slider + Horizontal Slider</title>
<!-- Fonts & Icons -->
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<!-- Swiper CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    html, body {
        margin: 0 !important;
        padding: 0 !important;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        height: 100%;
        height: 100dvh;
    }

    body {
        font-family: 'Cairo', sans-serif;
        background: #1a1a1a;
        overflow: hidden;
    }

    ::-webkit-scrollbar { display: none; }
    * { scrollbar-width: none; }

    * {
        text-wrap: wrap !important;
    }

/* ===== توحيد خط العناوين على Cairo ===== */
h1, h2, h3, h4, h5, h6,
.slide-text h2,
.licences-title h2,
.skills-title h2,
.experience-title h2,
.education-title h2,
.contact-title h2,
.social-title h2,
.licence-card h3,
.skill-card-header h3,
.timeline-role h3,
.education-info h3,
.contact-card-value,
.social-info-row span,
.lang-item .lang-name {
    font-family: 'Cairo', sans-serif !important;
    font-weight: 800;
}
    .vertical-slider {
        height: 100dvh;
        width: 100%;
        overflow-y: scroll;
        scroll-snap-type: y mandatory;
        scroll-behavior: smooth;
        scroll-padding-top: 0;
        position: relative;
        z-index: 1;
        margin-top: 0 !important;
        padding-top: 0 !important;
    }

    /* ===== قائمة النبذة (About me) - متوافقة مع باقي الصفحات ===== */
    .pitch-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .pitch-list li.pitch-text {
        color: #e8e8e8;
        font-size: 1.1rem;
        line-height: 1.9;
        font-weight: 400;
        text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
        position: relative;
        padding-left: 26px;
        text-align: left;
        animation: fadeInUp 0.6s ease-out backwards;
        transition: color 0.25s ease, transform 0.25s ease;
    }

    .pitch-list li.pitch-text:nth-child(1) { animation-delay: 0.1s; }
    .pitch-list li.pitch-text:nth-child(2) { animation-delay: 0.25s; }

    /* النقطة الخضراء */
    .pitch-list li.pitch-text::before {
        content: '\f111'; /* fa-circle */
        font-family: 'Font Awesome 6 Free';
        font-weight: 900;
        color: #39ff14;
        font-size: 0.5rem;
        position: absolute;
        left: 0;
        top: 14px;
        text-shadow: 0 0 8px rgba(57, 255, 20, 0.7);
        transition: 0.25s;
    }

    .pitch-list li.pitch-text:hover {
        color: #ffffff;
        transform: translateX(3px);
    }

    .pitch-list li.pitch-text:hover::before {
        text-shadow: 0 0 14px rgba(57, 255, 20, 0.9);
    }

    .pitch-list li.pitch-text strong {
        color: #39ff14;
        font-weight: 700;
    }

    .v-section {
        min-height: 100dvh;
        width: 100%;
        scroll-snap-align: start;
        scroll-margin-top: 0;
        overflow-y: visible;
        position: relative;
        background-color: transparent;
        margin: 0 !important;
        padding: 0 !important;
    }

    .first-section, .social-section {
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .section-content {
        min-height: 100dvh;
        width: 100%;
        display: flex;
        flex-direction: column;
        position: relative;
        z-index: 2;
        margin: 0 !important;
        padding: 0 24px !important;
    }

    .first-section .section-content { justify-content: center; }
    .social-section .section-content { justify-content: center; }

    .first-section,
    .first-section .section-content {
        height: 100dvh;
        padding: 0 !important;
    }

    /* ============ السلايدر ============ */
    .swiper-container {
        width: 100%;
        height: 100dvh !important;
        border-radius: 0px;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
        direction: rtl;
    }
    .swiper-slide {
        background-size: cover;
        background-position: top;
        background-repeat: no-repeat;
        position: relative;
        border-radius: 0px;
    }
    /* ===== Overlay مزدوج لزيادة وضوح النص ===== */
    .swiper-slide::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: 
            linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.35) 35%, transparent 60%),
            linear-gradient(125deg, rgba(0,0,0,0.7) 0%, rgba(57,255,20,0.07) 50%, rgba(0,0,0,0.6) 100%);
        z-index: 1;
    }
    .slide-text {
        position: absolute;
        bottom: 12%; right: 8%; left: 8%;
        color: #ffffff;
        z-index: 2;
        text-align: right;
    }
    .slide-text h2 {
        font-size: 3.2rem;
        font-weight: 800;
        margin-bottom: 12px;
        letter-spacing: -0.5px;
        color: #ffffff;
        /* Shadow احترافي متعدد الطبقات */
        text-shadow: 
            0 1px 2px rgba(0, 0, 0, 0.9),
            0 4px 12px rgba(0, 0, 0, 0.75),
            0 8px 30px rgba(0, 0, 0, 0.55);
    }
    .slide-text h2 span {
        color: #39ff14;
        font-weight: 900;
        text-shadow: 
            0 1px 2px rgba(0, 0, 0, 0.9),
            0 0 12px rgba(57, 255, 20, 0.85),
            0 0 28px rgba(57, 255, 20, 0.55),
            0 0 50px rgba(57, 255, 20, 0.35);
    }
    .slide-text p {
        font-size: 1.2rem;
        opacity: 0.98;
        color: #ffffff;
        font-weight: 500;
        text-shadow: 
            0 1px 2px rgba(0, 0, 0, 0.9),
            0 3px 10px rgba(0, 0, 0, 0.7);
    }

    /* ===== إبعاد نص الـ timeline والـ skills عن النقط على الموبايل ===== */
    .timeline-item {
        padding-right: 30px !important;
    }

    .timeline-list li,
    .skill-list li {
        text-align: left;
        padding-right: 0;
    }

    .timeline-role h3,
    .timeline-role .company {
        text-align: left;
    }

    /* ===== Badges احترافية مع Shadow داخلي وخارجي ===== */
    .slide-badges {
        margin-top: 22px;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }
    .slide-badge {
        background: rgba(0, 0, 0, 0.55);
        color: #39ff14;
        border: 1px solid rgba(57, 255, 20, 0.55);
        padding: 9px 22px;
        border-radius: 30px;
        font-size: 0.9rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 9px;
        backdrop-filter: blur(12px) saturate(160%);
        -webkit-backdrop-filter: blur(12px) saturate(160%);
        transition: all 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
        /* Shadow احترافي: خارجي + inner glow */
        box-shadow: 
            0 4px 14px rgba(0, 0, 0, 0.55),
            0 1px 3px rgba(0, 0, 0, 0.7),
            0 0 0 1px rgba(57, 255, 20, 0.08),
            inset 0 1px 0 rgba(255, 255, 255, 0.08),
            inset 0 0 20px rgba(57, 255, 20, 0.06);
        text-shadow: 
            0 1px 3px rgba(0, 0, 0, 0.9),
            0 0 10px rgba(57, 255, 20, 0.35);
        letter-spacing: 0.3px;
    }
    .slide-badge:hover {
        background: rgba(57, 255, 20, 0.18);
        border-color: #39ff14;
        color: #ffffff;
        transform: translateY(-3px);
        box-shadow: 
            0 8px 22px rgba(0, 0, 0, 0.6),
            0 0 0 1px rgba(57, 255, 20, 0.4),
            0 0 25px rgba(57, 255, 20, 0.45),
            inset 0 1px 0 rgba(255, 255, 255, 0.15),
            inset 0 0 22px rgba(57, 255, 20, 0.15);
        text-shadow: 
            0 1px 3px rgba(0, 0, 0, 0.9),
            0 0 14px rgba(57, 255, 20, 0.7);
    }
    .slide-badge i { 
        font-size: 0.9rem;
        filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.8));
    }

    .swiper-button-next, .swiper-button-prev {
        color: #39ff14;
        width: 46px; height: 46px;
        border-radius: 50%;
        transition: 0.3s;
    }
    .swiper-button-next:hover, .swiper-button-prev:hover { color: #ffffff; }
    .swiper-pagination-bullet { background: #a0a0a0; opacity: 0.8; }
    .swiper-pagination-bullet-active { background: #39ff14; transform: scale(1.2); }

    /* ============ الأقسام المشتركة ============ */
    .pitch-section,
    .about-section,
    .licences-section,
    .skills-section,
    .experience-section,
    .education-section,
    .contact-section,
    .social-section {
        background: transparent;
    }

    .pitch-section::before,
    .about-section::before,
    .licences-section::before,
    .skills-section::before,
    .experience-section::before,
    .education-section::before,
    .contact-section::before,
    .social-section::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background-image: 
            linear-gradient(125deg, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.65) 50%, rgba(0,0,0,0.88) 100%),
            url('https://truckdriver.shairha.com/wp-content/uploads/2026/10/BACKGROUND_1.webp');
        background-size: cover, cover;
        background-position: center center, center center;
        background-repeat: no-repeat, no-repeat;
        background-attachment: scroll, scroll;
        z-index: 1;
    }

    .pitch-section .section-content,
    .about-section .section-content,
    .licences-section .section-content,
    .skills-section .section-content,
    .experience-section .section-content,
    .education-section .section-content,
    .contact-section .section-content,
    .social-section .section-content {
        justify-content: center;
        align-items: center;
        z-index: 2;
    }

    .pitch-box {
        max-width: 950px;
        width: 100%;
        background: rgba(20, 20, 20, 0.75);
        border: 1px solid rgba(57, 255, 20, 0.35);
        border-radius: 28px;
        padding: 50px 45px;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6),
                    0 0 40px rgba(57, 255, 20, 0.08);
        text-align: right;
        direction: ltr;
        animation: fadeInUp 0.8s ease-out;
    }

    /* ===== الصفحة الثانية (Pitch) - الكلام من الشمال ===== */
    .pitch-section .pitch-box {
        text-align: left;
    }

    .pitch-section .pitch-box .pitch-text {
        text-align: left;
    }

    .pitch-section .pitch-box .pitch-label {
        text-align: left;
    }

    /* ===== الصفحة الثالثة (About Me) - الكلام من الشمال زي التانية ===== */
    .about-section .pitch-box {
        text-align: left;
    }

    .about-section .pitch-box .pitch-text {
        text-align: left;
    }

    .about-section .pitch-box .pitch-label {
        text-align: left;
    }

    .about-section .about-tags {
        justify-content: flex-start;
    }

    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .pitch-label {
        display: inline-block;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #39ff14;
        background: rgba(57, 255, 20, 0.1);
        border: 1px solid rgba(57, 255, 20, 0.4);
        padding: 8px 20px;
        border-radius: 40px;
        margin-bottom: 28px;
    }

    .pitch-text {
        font-size: 1.35rem;
        line-height: 2;
        color: #e8e8e8;
        font-weight: 400;
        text-shadow: 0 1px 6px rgba(0,0,0,0.6);
    }

    .pitch-text strong {
        color: #39ff14;
        font-weight: 700;
    }

    .pitch-actions {
        display: flex;
        gap: 18px;
        margin-top: 38px;
        flex-wrap: wrap;
        direction: ltr;
    }

    .pitch-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding: 16px 32px;
        font-size: 1rem;
        font-weight: 700;
        font-family: 'Cairo', sans-serif;
        text-decoration: none;
        border-radius: 14px;
        cursor: pointer;
        transition: all 0.3s ease;
        border: 2px solid transparent;
        letter-spacing: 0.3px;
        white-space: nowrap;
    }

    .pitch-btn-cv {
        background: #39ff14;
        color: #1a1a1a;
        border-color: #39ff14;
        box-shadow: 0 0 20px rgba(57, 255, 20, 0.25);
    }
    .pitch-btn-cv:hover {
        background: transparent;
        color: #39ff14;
        transform: translateY(-3px);
        box-shadow: 0 0 30px rgba(57, 255, 20, 0.5);
    }

    .pitch-btn-wa {
        background: transparent;
        color: #ffffff;
        border-color: rgba(255, 255, 255, 0.4);
    }
    .pitch-btn-wa:hover {
        background: #25D366;
        border-color: #25D366;
        color: #ffffff;
        transform: translateY(-3px);
        box-shadow: 0 0 30px rgba(37, 211, 102, 0.5);
    }

    .pitch-btn i { font-size: 1.15rem; }

    /* ===== About Me ===== */
    .about-section .pitch-text {
        font-size: 1.2rem;
        line-height: 2.1;
    }
    .about-section .pitch-text p + p {
        margin-top: 22px;
    }

    .about-tags {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 30px;
        direction: ltr;
    }
    .about-tag {
        background: rgba(57,255,20,0.1);
        color: #39ff14;
        border: 1px solid rgba(57,255,20,0.4);
        padding: 7px 18px;
        border-radius: 30px;
        font-size: 0.85rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: 0.3s;
    }
    .about-tag:hover {
        background: rgba(57,255,20,0.2);
        transform: translateY(-2px);
    }

    /* ===== Licences Section ===== */
    .licences-box {
        max-width: 1100px;
        width: 100%;
        text-align: right;
        direction: ltr;
    }

    .licences-title {
        text-align: center;
        margin-bottom: 40px;
    }

    .licences-title h2 {
        font-size: 2.2rem;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: 0.5px;
        margin-bottom: 12px;
        text-shadow: 0 2px 15px rgba(0,0,0,0.6);
    }

    .licences-title h2 span {
        color: #39ff14;
        text-shadow: 0 0 15px rgba(57,255,20,0.6);
    }

    .licences-title p {
        color: #a0a0a0;
        font-size: 1rem;
        letter-spacing: 1px;
    }

    .licences-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 22px;
    }

    .licence-card {
        background: rgba(20, 20, 20, 0.78);
        border: 1px solid rgba(57, 255, 20, 0.25);
        border-radius: 22px;
        padding: 28px 26px;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        transition: all 0.35s ease;
        position: relative;
        overflow: hidden;
        animation: fadeInUp 0.6s ease-out backwards;
    }

    .licence-card:nth-child(1) { animation-delay: 0.05s; }
    .licence-card:nth-child(2) { animation-delay: 0.15s; }
    .licence-card:nth-child(3) { animation-delay: 0.25s; }

    .licence-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0;
        width: 4px;
        height: 100%;
        background: #39ff14;
        box-shadow: 0 0 15px rgba(57,255,20,0.6);
        opacity: 0.6;
        transition: 0.3s;
    }

    .licence-card:hover {
        border-color: rgba(57, 255, 20, 0.7);
        transform: translateY(-5px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.5),
                    0 0 30px rgba(57,255,20,0.15);
    }

    .licence-card:hover::before {
        opacity: 1;
        width: 6px;
    }

    /* ===== صف الأيقونة + الحالة ===== */
    .licence-top-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 18px;
    }

    .licence-top-right {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
    }

    .licence-icon {
        width: 55px;
        height: 55px;
        border-radius: 14px;
        background: rgba(57,255,20,0.12);
        border: 1px solid rgba(57,255,20,0.35);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #39ff14;
        font-size: 1.5rem;
        margin-bottom: 18px;
    }

    .licence-top-row .licence-icon {
        margin-bottom: 0;
    }

    .licence-card h3 {
        font-size: 1.15rem;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 16px;
        letter-spacing: 0.3px;
        line-height: 1.5;
    }

    .licence-card h3 span {
        color: #39ff14;
    }

    .licence-meta {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .licence-meta-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.92rem;
        padding: 8px 0;
        border-bottom: 1px dashed rgba(255,255,255,0.08);
    }

    .licence-meta-row:last-child {
        border-bottom: none;
    }

    .licence-meta-row .label {
        color: #a0a0a0;
        font-weight: 500;
    }

    .licence-meta-row .value {
        color: #e8e8e8;
        font-weight: 600;
        text-align: right;
    }

    .licence-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(57,255,20,0.15);
        color: #39ff14;
        border: 1px solid rgba(57,255,20,0.45);
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        flex-shrink: 0;
        white-space: nowrap;
    }

    .licence-status::before {
        content: '';
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #39ff14;
        box-shadow: 0 0 8px #39ff14;
        animation: pulse 1.5s infinite;
    }

    @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
    }

    /* ===== زرار View (أيقونة عين فقط) ===== */
    .licence-view-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        background: rgba(57,255,20,0.1);
        color: #39ff14;
        border: 1px solid rgba(57,255,20,0.5);
        border-radius: 50%;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.35s ease;
        box-shadow: 0 4px 14px rgba(0,0,0,0.4),
                    inset 0 1px 0 rgba(255,255,255,0.06),
                    inset 0 0 14px rgba(57,255,20,0.06);
        flex-shrink: 0;
        padding: 0;
    }
    .licence-view-btn i {
        font-size: 0.95rem;
        filter: drop-shadow(0 1px 3px rgba(0,0,0,0.7));
        pointer-events: none;
    }
    .licence-view-btn:hover {
        background: rgba(57,255,20,0.25);
        border-color: #39ff14;
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 8px 22px rgba(0,0,0,0.5),
                    0 0 22px rgba(57,255,20,0.4),
                    inset 0 1px 0 rgba(255,255,255,0.12);
    }

    .licence-card.safety-record {
        grid-column: 1 / -1;
        background: linear-gradient(125deg, rgba(57,255,20,0.12) 0%, rgba(20,20,20,0.85) 100%);
        border-color: rgba(57,255,20,0.5);
        display: flex;
        align-items: center;
        gap: 28px;
        padding: 30px 32px;
        flex-wrap: wrap;
    }

    .licence-card.safety-record::before {
        opacity: 1;
        width: 5px;
    }

    .licence-card.safety-record .licence-icon {
        width: 70px;
        height: 70px;
        font-size: 2rem;
        background: rgba(57,255,20,0.18);
        border-color: rgba(57,255,20,0.55);
        box-shadow: 0 0 25px rgba(57,255,20,0.3);
        margin-bottom: 0;
        flex-shrink: 0;
    }

    .safety-content {
        flex: 1;
        min-width: 250px;
    }

    .safety-content h3 {
        margin-bottom: 8px;
        font-size: 1.3rem;
    }

    .safety-content p {
        color: #c0c0c0;
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .safety-content p strong {
        color: #39ff14;
        font-weight: 700;
    }

    /* ===== Popup / Lightbox ===== */
    .licence-popup {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.88);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        opacity: 0;
        visibility: hidden;
